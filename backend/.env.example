# Backend environment variables — V1.1
# Copy to .env locally for development. On Railway, set in the Variables tab.
# Never commit the real .env file.

# Anthropic API key (chatbotiq-dev for testing, chatbotiq-prod for paying clients)
ANTHROPIC_API_KEY=sk-ant-...

# CORS allow-list — set to the Netlify URL in production
ALLOWED_ORIGIN=https://streamlineai-chatbotiq.netlify.app

# Supabase — V1.1
# URL: from Supabase project Home page (e.g. https://aooncxlszohzixuodgjr.supabase.co)
# SECRET_KEY: from Supabase Settings → API Keys → "+ New secret key"
#             (NOT the publishable key. NOT the anon legacy key.)
SUPABASE_URL=https://aooncxlszohzixuodgjr.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Optional — Railway sets this automatically
PORT=3000
